{
  "name": "pdf-scanner-app",
  "version": "1.0.0",
  "description": "Aplikasi Web Scan Dokumen ke PDF via Kamera HP dengan Auto-Detect Sudut dan Filter Dokumen Bersih",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "postinstall": "node scripts/prepare-ocr.mjs",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "start": "node server.mjs",
    "dev": "node server.mjs"
  },
  "keywords": [
    "camscanner",
    "pdf-scanner",
